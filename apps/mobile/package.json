{
  "name": "@jsr/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "JSR Task Management System - React Native + Expo Mobile App",
  "main": "index.js",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "echo 'Mobile app build requires EAS CLI. Run: npm install -g eas-cli'",
    "build:android": "echo 'Mobile app build requires EAS CLI. Run: npm install -g eas-cli'",
    "build:ios": "echo 'Mobile app build requires EAS CLI. Run: npm install -g eas-cli'",
    "lint": "eslint .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@apollo/client": "^4.0.9",
    "@jsr/shared": "*",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/datetimepicker": "8.0.1",
    "@react-native-community/netinfo": "11.3.1",
    "@react-native-picker/picker": "2.7.5",
    "@react-navigation/bottom-tabs": "^6.5.0",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/native-stack": "^6.9.0",
    "apollo3-cache-persist": "^0.15.0",
    "expo": "~54.0.23",
    "expo-camera": "~15.0.16",
    "expo-image-picker": "~15.1.0",
    "expo-local-authentication": "~14.0.1",
    "expo-notifications": "~0.28.19",
    "expo-secure-store": "~13.0.2",
    "graphql": "^16.12.0",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-paper": "^5.14.5",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-vector-icons": "^10.3.0",
    "typescript": "~5.3.3"
  },
  "devDependencies": {
    "@types/react": "~18.2.79",
    "@types/react-native": "^0.73.0",
    "eslint": "^9",
    "typescript": "~5.3.3"
  },
  "expo": {
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera."
        }
      ]
    ]
  }
}
