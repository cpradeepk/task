{
  "name": "@jsr/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "JSR Task Management System - React Native + Expo Mobile App",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "echo 'Mobile app build requires EAS CLI. Run: npm install -g eas-cli'",
    "build:android": "echo 'Mobile app build requires EAS CLI. Run: npm install -g eas-cli'",
    "build:ios": "echo 'Mobile app build requires EAS CLI. Run: npm install -g eas-cli'",
    "lint": "eslint .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@jsr/shared": "*",
    "@react-navigation/bottom-tabs": "^6.5.0",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/native-stack": "^6.9.0",
    "expo": "^51.0.0",
    "expo-async-storage": "^12.0.0",
    "expo-camera": "^14.0.0",
    "expo-image-picker": "^14.0.0",
    "expo-notifications": "^0.27.0",
    "expo-secure-store": "^12.0.0",
    "react": "^19",
    "react-native": "^0.74.0",
    "react-native-gesture-handler": "^2.14.0",
    "react-native-reanimated": "^3.6.0",
    "react-native-safe-area-context": "^4.8.0",
    "react-native-screens": "^3.29.0",
    "typescript": "^5"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-native": "^0.74.0",
    "eslint": "^9",
    "typescript": "^5"
  },
  "expo": {
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera."
        }
      ]
    ]
  }
}
