          timerTotalTime
          actualHours
          createdAt
          updatedAt
        }
        users {
          employeeId
          name
          email
          department
          role
          status
        }
        settings {
          key
          value
          type
          isActive
        }
      }
    }
  `,
    // Get all tasks with optional filters
    GET_TASKS: `
    query GetTasks($assignedTo: String, $status: String, $priority: String) {
      tasks(assignedTo: $assignedTo, status: $status, priority: $priority) {
        id
        taskId
        selectType
        recursiveType
        description
        assignedTo
        assignedBy
        support
        startDate
        endDate
        priority
        estimatedHours
        actualHours
        projectId
        subprojectId
        status
