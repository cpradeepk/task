  /**
   * Bug Helper Utilities
   * 
   * Provides utility functions for bug-related operations:
   * - Bug ID display formatting (FT- prefix for features)
   * - Bug type helpers
   * - Bug status helpers
   */

  /**
   * Get display ID for a bug
   * 
   * Adds FT- prefix for feature-type bugs
   * 
   * @param bugId - The actual bug ID (e.g., "DEV-0001")
   * @param bugType - The bug type ("feature" or "testcase")
   * @returns Display ID with FT- prefix for features (e.g., "FT-DEV-0001")
   * 
   * @example
   * getBugDisplayId("DEV-0001", "feature") // Returns "FT-DEV-0001"
   * getBugDisplayId("DEV-0001", "testcase") // Returns "DEV-0001"
   * getBugDisplayId("DEV-0001", null) // Returns "DEV-0001"
   */
  function getBugDisplayId(bugId, bugType) {
    if (!bugId) return '';

    // Add FT- prefix for feature-type bugs
    if (bugType === 'feature') {
      return `FT-${bugId}`;
    }
    return bugId;
  }

  /**
   * Check if a bug is a feature
   */
  function isFeatureBug(bugType) {
    return bugType === 'feature';
  }

  /**
   * Check if a bug is a testcase
   */
  function isTestcaseBug(bugType) {
    return bugType === 'testcase' || !bugType;
  }

  /**
   * Get bug type display name
   */
  function getBugTypeDisplayName(bugType) {
    if (bugType === 'feature') return 'Feature';
    if (bugType === 'testcase') return 'Test Case';
    return 'Test Case'; // Default
  }

  /**
   * Get severity color
   */
  function getSeverityColor(severity) {
    switch (severity) {
      case 'Critical':
        return '#EF4444';
      case 'Major':
        return '#F97316';
      case 'Minor':
        return '#EAB308';
      default:
        return '#6B7280';
    }
  }

  /**
   * Get status color
   */
  function getStatusColor(status) {
    switch (status) {
      case 'New':
        return '#3B82F6';
      case 'In Progress':
        return '#EAB308';
      case 'Resolved':
        return '#10B981';
      case 'Closed':
        return '#6B7280';
      case 'Reopened':
        return '#EF4444';
      default:
        return '#6B7280';
    }
  }

  /**
   * Get priority color
   */
  function getPriorityColor(priority) {
    switch (priority) {
      case 'High':
        return '#EF4444';
      case 'Medium':
        return '#F97316';
      case 'Low':
        return '#10B981';
      default:
        return '#6B7280';
    }
  }

  /**
   * Get category icon
   */
  function getCategoryIcon(category) {
    switch (category) {
      case 'UI':
        return '🎨';
      case 'API':
        return '🔌';
      case 'Backend':
        return '⚙️';
      case 'Performance':
        return '⚡';
      case 'Security':
        return '🔒';
      case 'Database':
        return '💾';
      case 'Integration':
        return '🔗';
      default:
        return '🐛';
    }
  }

  /**
   * Get platform icon
   */
  function getPlatformIcon(platform) {
    switch (platform) {
      case 'iOS':
        return '🍎';
      case 'Android':
        return '🤖';
      case 'Web':
        return '🌐';
      case 'All':
        return '📱';
      default:
        return '📱';
    }
  }

  /**
   * Check if bug should show timer
   * Timers should NOT show for Closed or Resolved status
   */
  function shouldShowTimer(status) {
    return status !== 'Closed' && status !== 'Resolved';
  }

  /**
   * Format timer duration (seconds to HH:MM:SS)
   */
  function formatTimerDuration(seconds) {
    var hours = Math.floor(seconds / 3600);
    var minutes = Math.floor(seconds % 3600 / 60);
    var secs = seconds % 60;
    return `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
  }
