          description
          assignedTo
          status
          isCompleted
          displayOrder
          createdAt
          updatedAt
          createdBy
        }
      }
    }
  `,
    // Get all bugs with optional filters
    GET_BUGS: `
    query GetBugs($assignedTo: String, $status: String, $severity: String, $category: String) {
      bugs(assignedTo: $assignedTo, status: $status, severity: $severity, category: $category) {
        id
        bugId
        title
        description
        severity
        status
        category
        platform
        reportedBy
        assignedTo
        projectId
        subprojectId
        environment
        browser
