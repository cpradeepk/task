  var QUERIES = {
    // Dashboard query
    GET_DASHBOARD: `
    query GetDashboard($employeeId: String!, $role: String!) {
      dashboard(employeeId: $employeeId, role: $role) {
        tasks {
          id
          taskId
          description
          assignedTo
          assignedBy
